{
  "name": "@idfkit/core",
  "version": "0.0.0",
  "description": "Fast EnergyPlus IDF and epJSON parsing and manipulation for JavaScript",
  "type": "module",
  "license": "MIT",
  "author": "Samuel Letellier-Duchesne <developers@idfkit.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idfkit/idfkit-js.git",
    "directory": "packages/core"
  },
  "homepage": "https://js.idfkit.com/",
  "bugs": {
    "url": "https://github.com/idfkit/idfkit-js/issues"
  },
  "keywords": [
    "energyplus",
    "idf",
    "epjson",
    "building-energy",
    "simulation"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/types/*.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "idfkit": {
    "conformance": "conformance-2026.4",
    "governance": "governance-2026.4"
  },
  "dependencies": {
    "@idfkit/schemas": "0.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "codegen": "node scripts/emit-types.mjs"
  }
}
