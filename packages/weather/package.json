{
  "name": "@idfkit/weather",
  "version": "0.0.0",
  "description": "Browser-side EPW weather-file retrieval for EnergyPlus, from the climate.onebuilding.org TMYx index",
  "type": "module",
  "license": "MIT",
  "author": "Samuel Letellier-Duchesne <developers@idfkit.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idfkit/idfkit-js.git",
    "directory": "packages/weather"
  },
  "homepage": "https://js.idfkit.com/",
  "bugs": {
    "url": "https://github.com/idfkit/idfkit-js/issues"
  },
  "keywords": [
    "energyplus",
    "epw",
    "weather",
    "tmyx",
    "building-energy",
    "simulation"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./data/*": "./data/*"
  },
  "files": [
    "dist",
    "data",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build",
    "build:index": "node scripts/build-index.mjs"
  }
}
