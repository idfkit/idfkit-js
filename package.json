{
  "name": "idfkit-js",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:schemas": "node packages/schemas/scripts/build.mjs",
    "codegen": "node scripts/emit-types.mjs",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"{packages,docs}/**/*.{ts,mjs,json,md,css}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{packages,docs}/**/*.{ts,mjs,json,md,css}\" \"*.{json,md}\"",
    "check:absent-component": "node scripts/check-absent-component.mjs",
    "check:bundle-purity": "node scripts/check-bundle-purity.mjs",
    "check:conformance-level": "node scripts/emit-conformance.mjs --check",
    "check:facade": "node scripts/check-facade.mjs",
    "check:ignore-scripts": "node scripts/check-ignore-scripts.mjs",
    "check:install-size": "node scripts/check-install-size.mjs",
    "check:naming": "node scripts/check-naming-register.mjs",
    "check:no-index": "node scripts/check-no-index.mjs",
    "check:opt-out-typing": "node scripts/check-opt-out-typing.mjs",
    "check:parity": "node scripts/check-parity-ledger.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "check:release": "node scripts/check-release-conformance.mjs",
    "check:type-packages": "node scripts/check-type-packages.mjs",
    "docs:serve": "uv run --with-requirements docs-requirements.txt mkdocs serve",
    "docs:build": "uv run --with-requirements docs-requirements.txt mkdocs build --strict",
    "docs:api": "typedoc --json .typedoc.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "0.21.5",
    "prettier": "^3.4.2",
    "typedoc": "0.28.20",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "trailingComma": "es5",
    "printWidth": 100
  }
}
